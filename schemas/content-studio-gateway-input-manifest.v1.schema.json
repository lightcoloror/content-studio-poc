{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/schemas/content-studio-gateway-input-manifest.v1.schema.json",
  "title": "Content Studio Gateway Input Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "manifest_id",
    "synthetic_only",
    "source_artifact",
    "gateway_artifacts",
    "context"
  ],
  "properties": {
    "schema_version": {
      "const": "content-studio-gateway-input-manifest.v1"
    },
    "manifest_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{7,127}$"
    },
    "synthetic_only": {
      "const": true
    },
    "source_artifact": {
      "$ref": "#/$defs/sourceArtifact"
    },
    "gateway_artifacts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "$ref": "#/$defs/gatewayArtifact"
      }
    },
    "context": {
      "$ref": "#/$defs/context"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "not": {
        "pattern": "^(?:[A-Za-z]:[\\\\/]|[\\\\/]{2}|/)"
      }
    },
    "sourceArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "artifact_type",
        "schema_id",
        "relative_path",
        "sha256",
        "bytes",
        "mime_type",
        "synthetic_only"
      ],
      "properties": {
        "artifact_id": {"type": "string", "minLength": 1, "maxLength": 160},
        "artifact_type": {"enum": ["research-output", "content-item"]},
        "schema_id": {"type": "string", "minLength": 1, "maxLength": 240},
        "relative_path": {"$ref": "#/$defs/relativePath"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "bytes": {"type": "integer", "minimum": 1, "maximum": 20971520},
        "mime_type": {"const": "application/json"},
        "synthetic_only": {"const": true}
      }
    },
    "gatewayArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "relative_path",
        "sha256",
        "bytes",
        "mime_type",
        "data_type",
        "purpose",
        "consent_required"
      ],
      "properties": {
        "artifact_id": {"type": "string", "minLength": 1, "maxLength": 160},
        "relative_path": {"$ref": "#/$defs/relativePath"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "bytes": {"type": "integer", "minimum": 1, "maximum": 20971520},
        "mime_type": {
          "enum": ["application/json", "image/png", "image/jpeg", "image/webp"]
        },
        "data_type": {"type": "string", "minLength": 1, "maxLength": 120},
        "purpose": {"type": "string", "minLength": 12, "maxLength": 1000},
        "consent_required": {"const": true}
      }
    },
    "unknownRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "severity"],
      "properties": {
        "code": {"type": "string", "minLength": 1, "maxLength": 160},
        "severity": {"enum": ["info", "warning", "blocker"]}
      }
    },
    "contradictionRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claim_id", "evidence_id", "resolution_status", "evidence_status"],
      "properties": {
        "claim_id": {"type": "string", "minLength": 1, "maxLength": 160},
        "evidence_id": {"type": "string", "minLength": 1, "maxLength": 160},
        "resolution_status": {"type": "string", "minLength": 1, "maxLength": 80},
        "evidence_status": {"type": "string", "minLength": 1, "maxLength": 80}
      }
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_refs",
        "claim_refs",
        "evidence_refs",
        "unknown_refs",
        "contradiction_refs",
        "review_state",
        "risk_state"
      ],
      "properties": {
        "source_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "claim_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "evidence_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "unknown_refs": {"type": "array", "items": {"$ref": "#/$defs/unknownRef"}},
        "contradiction_refs": {"type": "array", "items": {"$ref": "#/$defs/contradictionRef"}},
        "review_state": {"type": "object"},
        "risk_state": {"type": "string", "minLength": 1, "maxLength": 120}
      }
    }
  }
}
